{
  "name": "phantom-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "verify:uniformity": "node scripts/chi-square-check.mjs",
    "check": "npm run type-check && npm run test && npm run verify:uniformity",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:claims": "playwright test e2e/claims.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.22.4",
    "typescript": "~7.0.2",
    "vite": "^8.2.1"
  }
}
